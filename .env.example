# Environment Configuration
# Copy this file to .env and fill in the values

# Sync API base URL — the AWS Lambda Function URL
# (Terraform output `function_url`). Replaces the former Apps Script URL.
PUBLIC_API_BASE_URL=https://YOUR_FUNCTION_URL.lambda-url.ap-southeast-2.on.aws/

# Auth — choose ONE mode:
#
# API-key mode (default): shared key, must match the Lambda's API_KEY.
PUBLIC_API_KEY=
#
# Google mode: set your Google OAuth Web client ID to authenticate with Google
# accounts instead of the shared key. When set, PUBLIC_API_KEY is ignored.
PUBLIC_GOOGLE_CLIENT_ID=

# Application metadata
PUBLIC_APP_NAME=Shopping List
PUBLIC_APP_VERSION=1.0.0
